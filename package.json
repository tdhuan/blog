{
  "name": "blog",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "check:watch": "astro check --watch",
    "format": "prettier . -c --write",
    "format:check": "prettier . --check",
    "lint": "eslint .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{css,scss,json,jsonc,md,yaml,yml}": [
      "prettier --write --cache"
    ],
    "*.astro": [
      "prettier --write --cache",
      "eslint --fix --cache --max-warnings=0"
    ],
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "prettier --write --cache"
    ]
  },
  "dependencies": {
    "@astrojs/ts-plugin": "^1.10.10",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.1.6",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@typescript-eslint/parser": "8.67.0",
    "astro-eslint-parser": "3.0.0",
    "eslint": "^10.8.1",
    "eslint-plugin-astro": "^3.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript": "^6.0.3"
  }
}

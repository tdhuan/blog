---
import "@/styles/global.css";
import "@/styles/print.css";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import BackToTop from "@/components/BackToTop.astro";

interface Props {
  title?: string;
  bodyClass?: string;
  bodyStyle?: string;
  mainClass?: string;
}

const {
  title = "Huan's space",
  bodyClass = "",
  bodyStyle = "",
  mainClass = "",
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="sepia" class="scroll-smooth antialiased">
  <head>
    <script is:inline>
      // Restore the saved theme before first paint — no flash of the wrong
      // theme. Invalid or missing values fall back to sepia;
      // blocked storage (private mode) falls back to sepia too.
      try {
        var t = localStorage.getItem("theme");
        document.documentElement.dataset.theme =
          ["sepia", "light", "dark"].indexOf(t) === -1 ? "sepia" : t;
      } catch (e) {
        document.documentElement.dataset.theme = "sepia";
      }
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Spline+Sans:wght@400;500;700&family=Newsreader:wght@400;600&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body
    id="top"
    class:list={["text-primary", "font-sans", bodyClass]}
    style={bodyStyle}
  >
    <div class="background-drop"></div>
    <Header />
    <main id="main" class:list={["min-h-screen pt-5", mainClass]}>
      <slot />
    </main>
    <Footer />
    <BackToTop />
  </body>
</html>

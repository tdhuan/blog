---
import "@/styles/global.css";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import BackToTop from "@/components/BackToTop.astro";

interface Props {
  title?: string;
  bodyClass?: string;
  bodyStyle?: string;
  mainClass?: string;
}

const {
  title = "Huan's space",
  bodyClass = "",
  bodyStyle = "",
  mainClass = "",
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth antialiased">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Libre+Caslon+Text:wght@400;700&family=Spline+Sans:wght@400;500;600&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body
    id="top"
    class:list={["text-on-background", "font-regular", bodyClass]}
    style={bodyStyle}
  >
    <div class="background-drop"></div>
    <Header />
    <main id="main" class:list={["min-h-screen pt-5", mainClass]}>
      <slot />
    </main>
    <Footer />
    <BackToTop />
  </body>
</html>

---
interface Props {
  href: string;
  variant?: "primary" | "text";
}

const { href, variant = "text" } = Astro.props;

const variants = {
  primary:
    "bg-primary text-on-primary transition-opacity w-full hover:opacity-90 focus-visible:opacity-90 sm:w-auto",
  text: "transition-colors hover:bg-accent-faint/10 focus-visible:bg-accent-faint/10",
} as const;
---

<a
  class:list={[
    "group inline-flex items-center justify-center gap-2 px-8 py-4 font-sans font-medium duration-300",
    variants[variant],
  ]}
  href={href}
>
  <slot />
  <svg
    aria-hidden="true"
    class="size-4 transition-transform duration-300 group-hover:translate-x-0.5"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <path d="M5 12h14"></path>
    <path d="m12 5 7 7-7 7"></path>
  </svg>
</a>

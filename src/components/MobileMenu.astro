---
// Mobile-only nav dropdown: the hamburger toggle plus the panel it
// opens, hidden entirely from sm up. The panel is absolutely positioned
// and anchors to the nearest positioned ancestor — Header's <header
// class="relative"> — so this component must live inside it.
interface Props {
  links: readonly { href: string; label: string }[];
}

const { links } = Astro.props;

// Panel rows replace the desktop hover underline with full tap-target
// rows — same link tokens, sized for thumbs instead of cursors.
const menuLinkClass =
  "font-label text-primary hover:bg-surface-strong focus-visible:bg-surface-strong block rounded-lg px-4 py-3 transition-colors";
---

<!-- Root doubles as the script's event boundary (click-outside tests
     contains() against it). Keep it un-positioned so the absolute panel
     still anchors to the header rather than to this wrapper. -->
<div data-mobile-menu class="sm:hidden">
  <button
    type="button"
    data-menu-toggle
    aria-expanded="false"
    aria-controls="mobile-menu"
    aria-label="Menu"
    class="text-primary hover:bg-surface-strong focus-visible:ring-primary flex size-10 items-center justify-center rounded-full transition-colors focus-visible:ring-2"
  >
    <svg
      data-menu-icon="closed"
      aria-hidden="true"
      class="size-5"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <line x1="4" x2="20" y1="6" y2="6"></line>
      <line x1="4" x2="20" y1="12" y2="12"></line>
      <line x1="4" x2="20" y1="18" y2="18"></line>
    </svg>
    <svg
      data-menu-icon="open"
      aria-hidden="true"
      class="hidden size-5"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M18 6 6 18"></path>
      <path d="m6 6 12 12"></path>
    </svg>
  </button>

  <!-- Closed state lives in markup (invisible keeps the panel out of the
       a11y tree and tab order); the script swaps these classes so the
       fade/slide transition can run both ways. -->
  <div
    id="mobile-menu"
    data-menu-panel
    class="invisible absolute inset-x-0 top-full z-40 -translate-y-2 opacity-0 transition-[opacity,transform,visibility] duration-150 ease-out motion-reduce:transition-none"
  >
    <div class="container-page pt-2">
      <nav
        aria-label="Primary"
        class="bg-surface border-outline-variant rounded-xl border p-2"
      >
        {
          links.map(({ href, label }) => (
            <a class={menuLinkClass} href={href}>
              {label}
            </a>
          ))
        }
      </nav>
    </div>
  </div>
</div>

<script>
  // Mobile menu dropdown (see data-menu-panel markup note). Toggling
  // classes instead of the hidden attribute lets the CSS transition run;
  // aria-expanded on the button stays the source of truth for state.
  const menu = document.querySelector<HTMLElement>("[data-mobile-menu]");
  const toggle = menu?.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const panel = menu?.querySelector<HTMLElement>("[data-menu-panel]");
  const iconOpen = menu?.querySelector<SVGElement>('[data-menu-icon="open"]');
  const iconClosed = menu?.querySelector<SVGElement>(
    '[data-menu-icon="closed"]',
  );

  if (menu && toggle && panel) {
    const closedClasses = ["invisible", "opacity-0", "-translate-y-2"];

    const setOpen = (open: boolean) => {
      toggle.setAttribute("aria-expanded", String(open));
      for (const className of closedClasses) {
        panel.classList.toggle(className, !open);
      }
      iconClosed?.classList.toggle("hidden", open);
      iconOpen?.classList.toggle("hidden", !open);
    };

    const isOpen = () => toggle.getAttribute("aria-expanded") === "true";
    const close = () => setOpen(false);

    toggle.addEventListener("click", () => setOpen(!isOpen()));

    // Navigation is a full page load on this static site; close anyway so
    // the panel never lingers during the transition.
    panel.addEventListener("click", (event) => {
      if ((event.target as Element).closest("a")) close();
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && isOpen()) {
        close();
        toggle.focus();
      }
    });

    // Tap/click outside the menu closes the panel.
    document.addEventListener("pointerdown", (event) => {
      if (isOpen() && !menu.contains(event.target as Node)) close();
    });

    // At sm+ the whole menu is display:none — sync state so it doesn't
    // come back stale when the viewport shrinks again.
    window
      .matchMedia("(min-width: 640px)")
      .addEventListener("change", (event) => {
        if (event.matches) close();
      });
  }
</script>

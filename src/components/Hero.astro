---
import { Image } from "astro:assets";
import Avatar512 from "@/assets/avatar-512.png";
import ArrowLink from "@/components/ArrowLink.astro";
---

<section class="container-page pt-12 pb-16 lg:pt-32 lg:pb-24">
  <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2 lg:gap-8">
    <div class="flex flex-col items-center gap-6 lg:items-start lg:pr-12">
      <div
        class="font-label text-on-background-faint text-xs font-medium tracking-wide uppercase sm:text-sm"
      >
        Hello, I'm Huan
      </div>
      <h1
        class="font-headline text-primary text-4xl leading-[0.9] font-semibold tracking-tight sm:text-5xl lg:text-7xl"
      >
        Welcome to <br class="hidden lg:block" /> my little space.
      </h1>
      <p
        class="font-regular text-on-background-muted max-w-xl text-base lg:text-lg"
      >
        A place where I share thoughts on code, life <br />
        and things I’m learning along the way.
      </p>
      <div
        class="mt-4 flex w-full flex-col items-center gap-4 sm:w-auto sm:flex-row"
      >
        <ArrowLink href="/blog" variant="primary">Read latest posts</ArrowLink>
        <a
          class="text-primary font-label border-primary/20 inline-flex w-full items-center justify-center gap-2 rounded-none border bg-transparent px-8 py-4 transition-opacity hover:opacity-80 focus-visible:opacity-80 sm:w-auto"
          href="/about">About me</a
        >
      </div>
    </div>

    <div class="flex justify-center lg:justify-end">
      <!-- Oval backdrop -->
      <div class="relative">
        <div class="absolute inset-0 -z-10 flex items-center justify-center">
          <div
            class="bg-drop/90 absolute left-1/3 h-76 w-44 rotate-45 rounded-[50%] opacity-60 sm:h-95 sm:w-55 lg:h-130 lg:w-75"
          >
          </div>
        </div>
        <!-- Avatar -->
        <div
          class="relative z-0 h-56 w-56 overflow-hidden sm:h-70 sm:w-70 lg:h-95 lg:w-95"
        >
          <Image
            alt="Portrait"
            class="h-full w-full object-contain"
            src={Avatar512}
          />
        </div>
      </div>
    </div>
  </div>
</section>

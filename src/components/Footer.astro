---
import Logo from "./Logo.astro";

const socials = [
  { href: "https://x.com/huanatran", label: "Twitter" },
  { href: "https://github.com/tdhuan", label: "GitHub" },
  {
    href: "https://www.linkedin.com/in/huan-tran-432983109/",
    label: "LinkedIn",
  },
] as const;

const linkClass =
  "font-sans text-sm hover:text-on-background focus-visible:text-primary transition-colors";
---

<footer class="border-outline-variant mt-gutter no-print border-t">
  <div
    class="container-page flex flex-col items-center justify-between gap-6 py-12 md:flex-row"
  >
    <Logo />
    <div class="lg:gap-gutter flex gap-6">
      {
        socials.map(({ href, label }) => (
          <a class={linkClass} href={href} aria-disabled="true">
            {label}
          </a>
        ))
      }
    </div>
    <div class="font-mono text-sm">Made with &#9829; and Astro</div>
  </div>
</footer>

---
import Logo from "./Logo.astro";

const socials = [
  { href: "#", label: "Twitter" },
  { href: "#", label: "GitHub" },
  { href: "#", label: "LinkedIn" },
] as const;

const linkClass =
  "font-label text-sm hover:text-primary focus-visible:text-primary transition-colors";
---

<footer class="border-outline-variant mt-gutter border-t">
  <div
    class="container-page flex flex-col items-center justify-between gap-6 py-12 md:flex-row"
  >
    <Logo />
    <div class="lg:gap-gutter flex gap-6">
      {
        socials.map(({ href, label }) => (
          <a class={linkClass} href={href} aria-disabled="true">
            {label}
          </a>
        ))
      }
    </div>
    <div class="font-label text-sm">© 2026 Huan Tran. Built with ❤️</div>
  </div>
</footer>

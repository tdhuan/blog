---
// Section heading, optionally with a rule line filling the remaining width.
// The line is decorative (aria-hidden) and drawn as a border-t, not a
// background, so it prints without print-color-adjust (print dialogs drop
// background graphics).
interface Props {
  id: string;
  rule?: boolean;
}

const { id, rule = true } = Astro.props;
---

<div class="flex items-center gap-3 sm:gap-4">
  <h2
    id={id}
    class="text-primary sm:text-26 font-serif text-2xl font-semibold lg:text-3xl"
  >
    <slot />
  </h2>
  {
    rule && (
      <span
        aria-hidden="true"
        class="border-outline-variant/40 flex-1 border-t"
      />
    )
  }
</div>

---
import Layout from "@/layouts/Layout.astro";

const experience = [
  {
    title: "Software Engineer",
    company: "Camelo",
    period: "05/2021 — 03/2026",
    summary:
      "Contributed to the development and continued improvement of Camelo’s web product and customer-facing sites.",
    highlights: [
      "Helped evolve the web application from its early stages into a production product.",
      "Collaborated with designers to deliver features end to end, from planning and implementation through testing and release",
      "Built reusable, responsive interface patterns and documented them in Storybook for the team.",
      "Implemented data-driven interface flows using React and GraphQL.",
      "Investigated and resolved bugs in the web app.",
      "Supported teammates with implementation questions and day-to-day development work.",
    ],
    stack: [
      "TypeScript",
      "React",
      "Next.js",
      "GraphQL",
      "Tailwind CSS",
      "Headless UI",
      "TanStack Query",
      "React Hook Form",
      "Storybook",
    ],
  },
  {
    title: "Front End Engineer",
    company: "Sutrix Solution",
    period: "12/2020 — 05/2021",
    summary:
      "Contributed to the development and continued improvement of Camelo’s web product and customer-facing sites.",
    highlights: [
      "Helped evolve the web application from its early stages into a production product.",
      "Collaborated with designers to deliver features end to end, from planning and implementation through testing and release",
    ],
    stack: ["React, Redux"],
  },
] as const;

const education = [
  {
    institution: "VNUHCM - University of Science",
    degree: "Bachelor's degree, Information Technology",
    period: "2015 — 2019",
  },
] as const;
---

<Layout title="CV | Huan Tran">
  <article class="container-page py-8">
    <header class="border-outline-variant border-b pb-10 sm:pb-12">
      <div
        class="flex flex-col gap-10 lg:flex-row lg:items-start lg:justify-between lg:gap-16"
      >
        <div>
          <p
            class="font-label text-brown-500 text-xs font-medium tracking-wide uppercase"
          >
            Front end developer
          </p>
          <h1
            class="font-headline text-primary mt-4 text-5xl leading-[0.9] tracking-tight sm:text-[56px] lg:text-[64px]"
          >
            Huan Tran Dinh
          </h1>
          <p
            class="text-brown-600 mt-7 max-w-2xl text-base leading-relaxed sm:text-lg"
          >
            Software engineer interested in building considered digital
            experiences, useful tools, and the systems that make them last.
          </p>

          <div
            class="mt-8 flex flex-col items-start gap-4 sm:flex-row sm:items-center"
          >
            <p
              class="font-label text-brown-600 flex items-center gap-2 text-xs font-medium tracking-wide uppercase"
            >
              <span aria-hidden="true" class="bg-primary size-1.5 rounded-full"
              ></span>
              Open to opportunities
            </p>
            <a
              class="font-label border-primary/40 text-primary hover:border-primary focus-visible:border-primary inline-flex items-center gap-2 border-b px-0 py-1 text-xs font-medium transition-colors"
              href="#experience"
            >
              View experience
              <svg
                aria-hidden="true"
                class="size-3.5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M12 5v14"></path>
                <path d="m19 12-7 7-7-7"></path>
              </svg>
            </a>
          </div>
        </div>

        <address class="font-label grid gap-3 text-sm not-italic lg:min-w-60">
          <a
            class="text-brown-600 hover:text-primary focus-visible:text-primary flex items-center gap-3 transition-colors"
            href="mailto:tdhuan013@gmail.com"
          >
            <svg
              aria-hidden="true"
              class="text-primary size-4 shrink-0"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <rect width="20" height="16" x="2" y="4" rx="2"></rect>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
            </svg>
            tdhuan013@gmail.com
          </a>
          <a
            class="text-brown-600 hover:text-primary focus-visible:text-primary flex items-center gap-3 transition-colors"
            href="tel:+84962468571"
          >
            <svg
              aria-hidden="true"
              class="text-primary size-4 shrink-0"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path
                d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.12.9.33 1.78.62 2.63a2 2 0 0 1-.45 2.11L8 9.74a16 16 0 0 0 6 6l1.28-1.28a2 2 0 0 1 2.11-.45c.85.29 1.73.5 2.63.62A2 2 0 0 1 22 16.92Z"
              ></path>
            </svg>
            0962 468 571
          </a>
          <a
            class="text-brown-600 hover:text-primary focus-visible:text-primary flex items-center gap-3 transition-colors"
            href="https://github.com/tdhuan"
            rel="noreferrer"
            target="_blank"
          >
            <svg
              aria-hidden="true"
              class="text-primary size-4 shrink-0"
              viewBox="0 0 24 24"
              fill="currentColor"
            >
              <path
                d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.18-3.37-1.18-.46-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1 .07 1.54 1.04 1.54 1.04.9 1.53 2.35 1.09 2.92.83.09-.65.35-1.09.64-1.34-2.22-.25-4.56-1.11-4.56-4.95 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02A9.55 9.55 0 0 1 12 6.8c.85 0 1.7.11 2.5.34 1.91-1.3 2.75-1.02 2.75-1.02.55 1.38.2 2.4.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.85-2.34 4.7-4.57 4.95.36.31.68.91.68 1.84v2.73c0 .27.18.58.69.48A10 10 0 0 0 12 2Z"
              ></path>
            </svg>
            github.com/tdhuan
          </a>
        </address>
      </div>
    </header>

    <section
      id="experience"
      class="pt-10 sm:pt-12"
      aria-labelledby="experience-title"
    >
      <h2
        id="experience-title"
        class="font-headline text-primary text-2xl sm:text-[26px] lg:text-3xl"
      >
        Work Experience
      </h2>
      <ul class="mt-6" role="list">
        {
          experience.map(
            ({ title, company, period, summary, highlights, stack }, index) => (
              <li class="flex gap-4 sm:gap-6">
                <div
                  aria-hidden="true"
                  class="flex flex-col items-center gap-2.5"
                >
                  <span
                    class:list={[
                      "mt-2 size-2 shrink-0 rounded-full",
                      index === 0 ? "bg-primary/85" : "bg-brown-200/85",
                    ]}
                  />
                  <span class="bg-outline-variant/40 w-px flex-1" />
                </div>
                <div
                  class:list={[
                    "flex-1",
                    index < experience.length - 1 && "pb-10 sm:pb-12",
                  ]}
                >
                  <div class="flex flex-col gap-2 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
                    <h3 class="font-headline text-brown-800 text-xl leading-tight sm:text-[22px] lg:text-2xl">
                      {title}
                    </h3>
                    <p class="font-label text-brown-500 shrink-0 text-sm">
                      {period}
                    </p>
                  </div>
                  <p class="font-label text-brown-500 mt-2 text-sm">
                    {company}
                  </p>
                  <p class="text-brown-700 mt-4 max-w-3xl leading-relaxed">
                    {summary}
                  </p>
                  {highlights.length > 0 && (
                    <ul class="text-brown-700 marker:text-brown-500 mt-4 list-outside list-disc space-y-2 pl-5 text-sm leading-relaxed">
                      {highlights.map((highlight) => (
                        <li>{highlight}</li>
                      ))}
                    </ul>
                  )}
                  <dl class="mt-5 flex flex-wrap items-baseline gap-x-3 gap-y-1">
                    <dt class="font-label text-brown-500 text-xs font-medium tracking-wide uppercase">
                      Tech stack
                    </dt>
                    <dd class="text-brown-600 text-sm leading-relaxed">
                      {stack.join(" · ")}
                    </dd>
                  </dl>
                </div>
              </li>
            ),
          )
        }
      </ul>
    </section>

    <section
      class="border-outline-variant mt-10 border-t pt-10 sm:mt-12 sm:pt-12"
      aria-labelledby="education-title"
    >
      <h2
        id="education-title"
        class="font-headline text-primary text-2xl sm:text-[26px] lg:text-3xl"
      >
        Education
      </h2>
      <ul class="mt-9 space-y-8" role="list">
        {
          education.map(({ institution, degree, period }) => (
            <li>
              <div class="flex flex-col gap-2 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4">
                <h3 class="font-headline text-brown-800 text-xl leading-tight sm:text-[22px] lg:text-2xl">
                  {institution}
                </h3>
                <p class="font-label text-brown-500 shrink-0 text-sm">
                  {period}
                </p>
              </div>
              <p class="font-label text-brown-500 mt-2 text-sm">{degree}</p>
            </li>
          ))
        }
      </ul>
    </section>
  </article>
</Layout>
